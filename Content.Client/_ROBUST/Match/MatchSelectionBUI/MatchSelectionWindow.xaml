<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Match selector"
                      MinSize="400 300"
                      SetSize="410 310">
    <BoxContainer Name="MainContainer" Orientation="Vertical" Margin="10 0 20 0">
        <BoxContainer Orientation="Horizontal" Margin="5">
            <Label Text="Match type: " />
            <OptionButton Name="MatchTypes" />
        </BoxContainer>
        <BoxContainer Name="SettingsContainer" Margin="10, 10, 10, 10">

        </BoxContainer>
        <Button Name="StartMatchButton" Text="Start match!" ToggleMode="True" Margin="5"/>
    </BoxContainer>
</controls:FancyWindow>
